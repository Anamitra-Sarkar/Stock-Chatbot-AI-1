# Server Environment Variables

# Required: Groq AI API Key
GROQ_API_KEY=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

# Optional: Tavily Search API Key (for real-time search capabilities)
# If not provided, time-sensitive queries will use time context only without search
TAVILY_API_KEY=your_tavily_api_key_here

# Node Environment (production/development)
NODE_ENV=development

# Port (Render will set this automatically)
PORT=5000

# Required: Allowed Origins for CORS (comma-separated)
# Add your Vercel frontend URL here
# Example: https://your-app.vercel.app,https://your-app-preview.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-app.vercel.app

# Optional: Database URL (if you want persistent storage)
# If not provided, the app uses in-memory storage
# DATABASE_URL=postgresql://user:password@host:port/database
